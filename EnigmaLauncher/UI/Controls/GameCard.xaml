<UserControl x:Class="EnigmaLauncher.UI.Controls.GameCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EnigmaLauncher.UI.Controls"
             Width="200" Height="320"
             Cursor="Hand">
    <UserControl.Resources>
        <Style x:Key="GameActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="170"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.74"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3D5C72"/>
                                <Setter Property="Foreground" Value="#FF6B8999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="CardBorder" CornerRadius="6" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#1E2837"/>
                <Setter Property="BorderBrush" Value="#2A475E"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="BorderBrush" Value="#66C0F4"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="267"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ClipToBounds="True">
                <Border CornerRadius="6,6,0,0" ClipToBounds="True">
                    <Border x:Name="Placeholder" CornerRadius="6,6,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1B2838" Offset="0"/>
                                <GradientStop Color="#2A475E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="?" Foreground="#4A6A80" FontSize="48"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Border>

                <Image x:Name="ArtworkImage" Stretch="UniformToFill" Visibility="Collapsed"/>

                <Grid Panel.ZIndex="5" Background="#BF000000">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="HoverNameText"
                                   Foreground="White" FontSize="14" FontWeight="Bold"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="180" Margin="0,0,0,12"/>
                        <Button Content="&#x25B6;   Play"
                                Style="{StaticResource GameActionButton}"
                                Background="#FF1A9FFF"
                                FontSize="14" Padding="0,9"
                                Click="PlayButton_Click"/>
                        <Button x:Name="DesktopShortcutButton"
                                Content="&#x1F4CC;  Create Desktop Shortcut"
                                Style="{StaticResource GameActionButton}"
                                Background="#FF16A34A"
                                FontSize="11.5"
                                Margin="0,8,0,0"
                                Click="DesktopShortcutButton_Click"/>
                        <Button x:Name="OpenInLibraryButton"
                                Content="Open in Steam Library"
                                Style="{StaticResource GameActionButton}"
                                Background="#FF2A475E"
                                Margin="0,8,0,0"
                                ToolTip="Switch account if needed, then open this game in Steam Library"
                                Click="OpenInLibraryButton_Click"/>
                        <Button x:Name="CustomShortcutButton"
                                Content="&#x1F517;  Create a shortcut"
                                Style="{StaticResource GameActionButton}"
                                Background="#FFF59E0B"
                                Margin="0,8,0,0"
                                Click="CustomShortcutButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="1" Margin="10,7,10,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="GameNameText" Grid.Column="0"
                           Foreground="#C6D4DF" FontSize="11.5" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           VerticalAlignment="Center" Margin="0,0,4,0"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                <!-- Display-settings icon button — faint until hover, never hidden -->
                <Button x:Name="DisplaySettingsButton" Grid.Column="1"
                        Width="28" Height="28" Margin="0,0,4,0"
                        ToolTip="Display settings for this game"
                        Click="DisplaySettingsButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Opacity" Value="0.55"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FF2A475E"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver,
                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Value="True">
                                    <Setter Property="Opacity" Value="1.0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid Width="24" Height="24">
                        <TextBlock Text="&#x1F5A5;" FontSize="16" Foreground="#FF66C0F4"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border Background="#FF2A475E" CornerRadius="6"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                MinWidth="11" Height="13" Padding="2,0">
                            <TextBlock x:Name="DisplayNumberText" Text="1"
                                       Foreground="White" FontSize="9" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Button>

                <controls:AccountBadge x:Name="Badge" Grid.Column="2"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Display-settings popup — floats above card, placement stable -->
            <Popup x:Name="DisplaySettingsPopup"
                   Grid.Row="0" Grid.RowSpan="2"
                   PlacementTarget="{Binding ElementName=DisplaySettingsButton}"
                   Placement="Left" HorizontalOffset="-4"
                   StaysOpen="False" AllowsTransparency="True"
                   PopupAnimation="Fade">
                <Border Background="#FF1B2838" BorderBrush="#FF2A475E"
                        BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel Width="210">
                        <TextBlock Text="Display Settings" Foreground="#FF66C0F4"
                                   FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <TextBlock Text="Target screen:" Foreground="#FF8BA6B5"
                                   FontSize="11" Margin="0,0,0,3"/>
                        <ComboBox x:Name="MonitorComboBox" FontSize="11" Margin="0,0,0,10"
                                  SelectionChanged="MonitorComboBox_SelectionChanged"/>

                        <TextBlock Text="Switch method:" Foreground="#FF8BA6B5"
                                   FontSize="11" Margin="0,0,0,3"/>
                        <ComboBox x:Name="MethodComboBox" FontSize="11" Margin="0,0,0,12"
                                  SelectionChanged="MethodComboBox_SelectionChanged"/>

                        <StackPanel x:Name="RevertDelayPanel" Orientation="Horizontal"
                                    Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBlock Text="Revert after (s):" Foreground="#FF8BA6B5" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button x:Name="RevertDelayMinusButton" Content="-" Width="22" Height="22"
                                    FontSize="12" Padding="0" Background="#FF2A475E" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" Click="RevertDelayMinusButton_Click"/>
                            <TextBox x:Name="RevertDelayTextBox" Width="34" FontSize="11"
                                     TextAlignment="Center" Margin="4,0" VerticalContentAlignment="Center"
                                     PreviewTextInput="RevertDelayTextBox_PreviewTextInput"/>
                            <Button x:Name="RevertDelayPlusButton" Content="+" Width="22" Height="22"
                                    FontSize="12" Padding="0" Background="#FF2A475E" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" Click="RevertDelayPlusButton_Click"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ClearDisplayButton"
                                    Content="Clear" FontSize="11"
                                    Padding="10,5" Margin="0,0,6,0"
                                    Background="#FF2A475E" Foreground="#FFC6D4DF"
                                    BorderThickness="0" Cursor="Hand"
                                    Click="ClearDisplayButton_Click"/>
                            <Button x:Name="SaveDisplayButton"
                                    Content="Save" FontSize="11"
                                    Padding="10,5"
                                    Background="#FF1A9FFF" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"
                                    Click="SaveDisplayButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
