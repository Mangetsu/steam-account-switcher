<Window x:Class="EnigmaLauncher.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About EnigmaLauncher"
        Icon="/Assets/app_icon.ico"
        Width="460" Height="400"
        MinWidth="420" MinHeight="390"
        ResizeMode="CanResize"
        Background="#FF171A21"
        WindowStartupLocation="CenterOwner">
    <Border Background="#FF171A21" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Image Source="/Assets/app_icon.ico" Width="42" Height="42" Margin="0,0,14,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="EnigmaLauncher"
                               Foreground="#FF66C0F4"
                               FontSize="22"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="VersionText"
                               Foreground="#FF8BA6B5"
                               FontSize="12"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1"
                    Height="1"
                    Background="#FF2A475E"
                    Margin="0,20,0,18"/>

            <StackPanel Grid.Row="2">
                <TextBlock Text="Smart game launcher for multi-monitor, multi-account Windows setups."
                           Foreground="#FFC6D4DF"
                           FontSize="14"
                           TextWrapping="Wrap"/>

                <TextBlock Text="EnigmaLauncher scans your installed Steam libraries, detects game ownership, switches accounts silently, routes games to the right display, and manages your desktop shortcuts."
                           Foreground="#FF8BA6B5"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           LineHeight="18"/>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Runtime"
                               Foreground="#FF6B7280" FontSize="12" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="RuntimeText"
                               Foreground="#FFC6D4DF" FontSize="12" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Install"
                               Foreground="#FF6B7280" FontSize="12" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InstallPathText"
                               Foreground="#FFC6D4DF" FontSize="12" Margin="0,0,0,8"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="License"
                               Foreground="#FF6B7280" FontSize="12"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="PolyForm NC"
                               Foreground="#FFC6D4DF" FontSize="12"/>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="GitHub"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Click="GitHubButton_Click"/>
                <Button Content="Close"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="76"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
