<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <AssemblyName>EnigmaLauncher</AssemblyName>
    <RootNamespace>EnigmaLauncher</RootNamespace>
    <!-- Single source of truth for the app version — AboutWindow reads it back via
         AssemblyInformationalVersionAttribute, and the SDK derives AssemblyVersion/FileVersion
         from it automatically at build time. -->
    <Version>2.0.0</Version>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ValveKeyValue" Version="0.10.*" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app_icon.ico" />
  </ItemGroup>

  <!-- The SDK appends the full 40-char git commit hash to InformationalVersion; truncate it to
       6 chars (still enough to pinpoint a build) before it gets baked in, so the About dialog
       shows "2.0.0+a1b2c3" instead of the full hash. -->
  <Target Name="TruncateSourceRevisionId" AfterTargets="InitializeSourceControlInformation">
    <PropertyGroup Condition="'$(SourceRevisionId)' != ''">
      <SourceRevisionId>$(SourceRevisionId.Substring(0, 6))</SourceRevisionId>
    </PropertyGroup>
  </Target>

</Project>
