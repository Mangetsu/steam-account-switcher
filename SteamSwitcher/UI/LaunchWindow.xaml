<Window x:Class="SteamSwitcher.UI.LaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SteamSwitcher"
        Icon="/Assets/app_icon.ico"
        Width="420" Height="170"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">
    <Border Background="#1B2838" CornerRadius="8" BorderBrush="#2A475E" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="SteamSwitcher" Foreground="#66C0F4" FontSize="13"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Status text -->
            <TextBlock x:Name="StatusText" Grid.Row="1"
                       Text="Initializing..."
                       Foreground="#C6D4DF"
                       FontSize="14"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>

            <!-- Error text (hidden by default) -->
            <TextBlock x:Name="ErrorText" Grid.Row="1"
                       Foreground="#E74C3C"
                       FontSize="13"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>

            <!-- Buttons (shown on timeout/error) -->
            <StackPanel x:Name="ButtonPanel" Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,12,0,0" Visibility="Collapsed">
                <Button x:Name="RetryButton" Content="Retry" Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0" Click="RetryButton_Click"/>
                <Button x:Name="CloseButton" Content="Close" Style="{StaticResource SecondaryButton}"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
