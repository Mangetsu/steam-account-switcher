<Window x:Class="SteamSwitcher.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SteamSwitcher.UI.Controls"
        Title="SteamSwitcher"
        Icon="/Assets/app_icon.ico"
        Width="1130" Height="820"
        MinWidth="700" MinHeight="490"
        Background="#FF171A21"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF1B2838" BorderBrush="#FF2A475E" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="SteamSwitcher"
                           Foreground="#FF66C0F4" FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Logged in as:" Foreground="#FF8BA6B5"
                               FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <Button x:Name="AccountSwitchButton"
                            Style="{StaticResource AccountDropButton}"
                            Click="AccountSwitchButton_Click"
                            ToolTip="Click to switch account">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="CurrentAccountBadge" CornerRadius="10" Padding="10,4">
                                <TextBlock x:Name="CurrentAccountText" Foreground="White"
                                           FontSize="13" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text=" &#x25BE;" Foreground="#FF8BA6B5"
                                       FontSize="11" VerticalAlignment="Center" Margin="3,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Popup x:Name="AccountSwitcherPopup"
                           PlacementTarget="{Binding ElementName=AccountSwitchButton}"
                           Placement="Bottom" VerticalOffset="4"
                           StaysOpen="False" AllowsTransparency="True">
                        <Border Background="#FF1B2838" BorderBrush="#FF2A475E"
                                BorderThickness="1" CornerRadius="6" Padding="4">
                            <StackPanel x:Name="AccountSwitcherPanel" MinWidth="170"/>
                        </Border>
                    </Popup>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#x2139; About" Style="{StaticResource IconButton}"
                            Margin="0,0,8,0" Click="AboutButton_Click"
                            ToolTip="About SteamSwitcher"/>
                    <Button Content="&#x21BB; Refresh" Style="{StaticResource IconButton}"
                            Click="RefreshButton_Click"
                            ToolTip="Reload games and accounts"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#FF1B2838" BorderBrush="#FF2A475E" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Filter:" Foreground="#FF8BA6B5"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <StackPanel x:Name="FilterPanel" Grid.Column="1"
                            Orientation="Horizontal" VerticalAlignment="Center"/>

                <TextBlock x:Name="GameCountText" Grid.Column="2"
                           Foreground="#FF6B7280" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Border x:Name="LoadingOverlay" Background="#CC171A21"
                    Panel.ZIndex="10" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="LoadingText" Text="Loading Steam library..."
                               Foreground="#FF66C0F4" FontSize="16" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LoadingSubText" Text="Scanning game libraries..."
                               Foreground="#FF8BA6B5" FontSize="12" Margin="0,8,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border x:Name="EmptyState" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="No games found" Foreground="#FF8BA6B5"
                               FontSize="18" HorizontalAlignment="Center"/>
                    <TextBlock Text="Make sure your Steam libraries are configured correctly."
                               Foreground="#FF6B7280" FontSize="13" Margin="0,8,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="GameGrid" Orientation="Horizontal" Margin="8"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
